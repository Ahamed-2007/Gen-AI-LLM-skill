      "source": [
        "from transformers import pipeline\n",
        "generator = pipeline(\"text-generation\",model=\"HuggingFaceTB/SmolLM2-360M\")\n",
        "prompt=input(\"Enter prompt\")\n",
        "generator(\n",
        "    prompt,\n",
        "    max_length=300,\n",
        "    num_return_sequences=2,\n",
        ")"
